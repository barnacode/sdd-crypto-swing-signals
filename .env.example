# AEGIS — environment template. Copy to .env and fill in. NEVER commit .env (CLAUDE.md §8).
# Exchanges (public OHLCV/futures), GDELT, RSS and FOMC dates need NO key.

# --- Database (TimescaleDB) ---
AEGIS_DB_DSN=postgresql+asyncpg://aegis:aegis@timescaledb:5432/aegis

# --- API auth ---
AEGIS_API_KEY=change-me-internal-service-key
AEGIS_JWT_SECRET=change-me-long-random-secret

# --- Market cap / dominance ---
COINGECKO_DEMO_KEY=

# --- Sentiment (regime filter) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SANTIMENT_API_KEY=

# --- Security / exploits ---
DEFI_API_KEY=

# --- Macro calendar ---
FMP_API_KEY=
FRED_API_KEY=

# --- Derivatives ---
COINGLASS_API_KEY=

# --- On-chain (DIY) ---
ETHERSCAN_KEY=
TRONGRID_KEY=

# --- Telegram (single private chat) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Cloudflare Zero Trust tunnel (private-network mode, no public hostname) ---
CLOUDFLARE_TUNNEL_TOKEN=
